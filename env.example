# Inject the @nilxone_bot token on edge-dev-1 via the deployment secret store.
TELEGRAM_BOT_TOKEN=
RUST_LOG=nilx_one_bot=info
# Optional Telegram login, both or neither. Requests are signed with
# TELEGRAM_BOT_TOKEN; no other credential exists.
# BOT_LOGIN_START_URL=https://nilx.one/api/v1/telegram/login/start
# BOT_OIDC_CALLBACK_URL=https://nilx.one/api/v1/telegram/login/callback
# Optional, staged and unwired: the map archive for Special pickup walks.
# BOT_MAP_ARCHIVE_URL=https://nilx.one/map/0.1.0/basemap.pmtiles
# Local JSON panel metadata only; never store login tokens or Core data.
# BOT_UI_STATE_PATH=bot-ui-state.json
