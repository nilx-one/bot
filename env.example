# Test-only. Do NOT use the token of the currently deployed nilx.one bot.
BOT_RUN_MODE=test
BOT_TEST_TOKEN=replace-with-a-separate-telegram-test-bot-token
# Required: checked against Telegram getMe before polling. Never @nilxone_bot.
BOT_TEST_USERNAME=your_separate_test_bot
RUST_LOG=nilx_one_bot=info
# Optional only after the Core login-start and dedicated callback are ready:
# BOT_LOGIN_START_URL=https://nilx.one/api/v1/telegram/login/start
# BOT_AIS_KEY_ID=registered-test-bot-key
# BOT_AIS_SIGNING_SEED=base64url-unpadded-32-byte-Ed25519-seed
# BOT_OIDC_CALLBACK_URL=https://nilx.one/api/v1/telegram/login/callback
# Optional, staged and unwired: the map archive for Special pickup walks.
# BOT_MAP_ARCHIVE_URL=https://nilx.one/map/0.1.0/basemap.pmtiles
# Local JSON panel metadata only; never store login tokens or Core data.
# BOT_UI_STATE_PATH=bot-ui-state.json
